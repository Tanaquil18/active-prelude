      <hint/>
      <answer>
        <sidebyside widths="45% 45%">
            <image>
                <prefigure xmlns="https://prefigure.org" label="prefigure-changing-composite-Dolbears-Law-degrees-F-ans">
                    <diagram dimensions="(300,300)" margins="5">
                    <definition>p1=(40,50)</definition>
                    <definition>p2=(80,60)</definition>
                    <definition>p3=(120,70)</definition>
                    <definition>p4=(160,80)</definition>
                    <definition>p5=(180,85)</definition>
                    <coordinates bbox="(-20,-10,200,100)">
                      <grid-axes xlabel="N \text{ (chirps/min)}"
                      ylabel="T \text{ (degrees Fahrenheit)}"
                      hlabels="(40,40,160)"  vlabels="(20,20,80)"
                      spacings="((-20,20,200),(-10,10,100))"/>
                      <line endpoints="(p1,p5)" stroke="blue" />
                      <point p="p1"/>
                      <point p="p2"/>
                      <point p="p3" alignment="se" offset="(.2,0)"><m>(120,70)</m></point>
                      <point p="p4"/>
                      <point p="p5"/>
                    </coordinates>
