<diagram xmlns="https://prefigure.org" width="300" height="300" margins="5">
  <definition>t(x)=2^x</definition>
  <definition>r(x)=e^x</definition>
  <definition>q(x)=3^x</definition>
  <coordinates bbox="[-3,-2,3,10]">
    <grid rx="(-3,1,3)" ry="(-2,2,10)"/>
    <axes id="axes" decorations="no"
	  hlabels="(-2,2,2)" vlabels="(-2,2,10)"
	  xlabel="t" ylabel="y"/>

    <graph function="r" />
    <graph function="t" dash="9 9" tactile-dash="9 9"/>
    <graph function="q" dash="9 9" tactile-dash="18 18"/>

    <point p="(0,1)"/>

    <label p="(2,4)" alignment="se" offset="(8,-8)" clear-background="yes">
      <m>2^t</m>
    </label>

    <label p="(log(8),8)" alignment="east" offset="(10,0)" clear-background="yes">
      <m>e^t</m>
    </label>

    <label p="(1.5,8)" alignment="west" offset="(0,0)" clear-background="yes">
      <m>3^t</m>
    </label>

  </coordinates>





</diagram>

