<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition>f(x)=2</definition>
  <definition>p(x)=6*0.75^x+f(x)</definition>
  <coordinates bbox="[-2,-2,12,12]">
    <axes id="axes" decorations="no"
	  xlabel="t" ylabel="y"/>

    <graph function="p"/>
    <graph function="f" stroke="green" tactile-dash="9 9"/>

    <point p="(0,p(0))" alignment="ne">
      <m>(0,a+c)</m>
    </point>
    <label p="(4,p(4))" alignment="ne">
      <m>f(t)=a~b^t+c</m>
    </label>
    <label p="(1,f(0))" alignment="ne" tactile-offset="(0,10)">
      <m>y=c</m>
    </label>


  </coordinates>





</diagram>

