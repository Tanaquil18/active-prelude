<diagram xmlns="https://prefigure.org" width="300" height="300" margins="5">
  <definition>t(x)=2^x</definition>
  <definition>r(x)=e^x</definition>
  <definition>q(x)=4^x</definition>
  <definition>p(x)=6^x</definition>
  <coordinates bbox="[-3,-2,3,10]">
    <grid rx="(-3,1,3)" ry="(-2,2,10)"/>
    <axes id="axes" decorations="no"
	  hlabels="(-2,2,2)" vlabels="(-2,2,10)"
	  xlabel="t" ylabel="y"/>

    <graph function="r" />
    <graph function="t" stroke="green" tactile-dash="9 9"/>
    <graph function="q" stroke="magenta" tactile-dash="18 18"/>
    <graph function="p" stroke="orange" tactile-dash="9 9"/>

    <point p="(0,1)"/>

    <label p="(2,4)" alignment="se" offset="(2,-2)" clear-background="yes">
      <m>s(x)</m>
    </label>

    <label p="(1.75,6)" alignment="c" clear-background="yes">
      <m>r(x)</m>
    </label>

    <label p="(1.5,8)" alignment="center" offset="(3,0)" clear-background="yes">
      <m>q(x)</m>
    </label>

    <label p="(1,6)" alignment="west" clear-background="yes">>
      <m>p(x)</m>
    </label>



  </coordinates>





</diagram>

