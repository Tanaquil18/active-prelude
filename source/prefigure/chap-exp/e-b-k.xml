<diagram xmlns="https://prefigure.org" width="300" height="300" margins="5">
  <definition>r(x)=e^x</definition>
  <definition>a=2</definition>
  <definition>b=7</definition>
  <definition>c=4.3</definition>
  <coordinates bbox="[-3,-2,3,10]">
    <grid rx="(-3,1,3)" ry="(-2,2,10)"/>
    <axes id="axes" decorations="no"
	  hlabels="(-2,2,2)" vlabels="(4,4,10)"
	  xlabel="t" ylabel="y"/>

    <graph function="r" />

    <polygon points="((0,a),(log(a),a),(log(a),0))" thickness="2"
	     stroke="red" tactile-dash="9 9"/>
    <polygon points="((0,b),(log(b),b),(log(b),0))" thickness="2"
	     stroke="red" tactile-dash="9 9"/>
    <polygon points="((0,c),(log(c),c),(log(c),0))" thickness="2"
	     stroke="red" tactile-dash="9 9"/>

    <point p="(log(a),a)"/>
    <point p="(log(b),b)"/>
    <point p="(log(c),c)"/>

    <label p="(log(8),8)" alignment="nw" offset="(-8,8)" clear-background="yes">
      <m>e^t</m>
    </label>

    <label p="(0,2)" alignment="west" offset="(-8,0)" clear-background="yes">
      <m>b</m>
    </label>

    <label p="(log(2),0)" alignment="south" offset="(0,-8)" clear-background="yes">
      <m>k</m>
    </label>

  </coordinates>





</diagram>

