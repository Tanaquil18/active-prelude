    <axes id="axes" decorations="no"
	  ylabel="y"/>

    <graph function="p"/>

    <point p="(0,p(0))" alignment="ne">
      <m>(0,a)</m>
    </point>
    <label p="(4,p(4))" alignment="ne">
      <m>f(t)=a~b^t</m>
    </label>
    <label p="(12,0)" alignment="nw" offset="(-4,10)">
      <m>t</m>
    </label>


  </coordinates>





</diagram>

