<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition>p(x)=2^x</definition>
  <definition>q(x)=0.5^x</definition>
  <coordinates bbox="[-3,-2,3,10]">
    <grid rx="(-3,1,3)" ry="(-2,2,10)" />
    <axes id="axes" decorations="no"
	  xlabel="t" ylabel="y"
	  hlabels="(-2,2,2)" vlabels="(0,2,10)"/>

    <graph function="p"/>
    <graph function="q" stroke="green" tactile-dash="9 9"/>

    <label p="(2,p(2))" alignment="nw">
      <m>p(t)</m>
    </label>
    <label p="(-2,q(-2))" alignment="ne">
      <m>q(t)</m>
    </label>


  </coordinates>





</diagram>

