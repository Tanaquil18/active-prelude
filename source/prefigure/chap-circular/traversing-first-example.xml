<diagram xmlns="https://prefigure.org" width="250" height="250" margins="15">
  <coordinates bbox="[-6,-2,6,10]">
    <group>
      <grid id="grid" rx="(-6,2,6)" ry="(-2,2,10)"/>
      <axes id="axes" decorations="no"
	    hlabels="(-4,8,4)" vlabels="(2,2,6)"
	    hticks="(-4,2,4)" vticks="(-2,2,10)"/>
    </group>

    <definition>r=12/pi</definition>
    <definition>p1=(r*sin(pi/4), -r*cos(pi/4)+r)</definition>
    <definition>p5=(r*sin(5*pi/4), -r*cos(5*pi/4)+r)</definition>
    <line p1="(p1[0],0)" p2="p1" stroke="green" tactile-dash="8 8"/>
    <line p1="(p5[0],0)" p2="p5" stroke="green" tactile-dash="8 8"/>
    <circle center="(0,r)" r="r" />

    <point p="(r*sin(0*pi/4), -r*cos(0*pi/4)+r)" alignment="se">
      <m>d=0</m>
    </point>
    <point p="(r*sin(1*pi/4), -r*cos(1*pi/4)+r)" alignment="se">
      <m>d=3</m>
    </point>
    <point p="(r*sin(2*pi/4), -r*cos(2*pi/4)+r)" alignment="se">
      <m>d=6</m>
    </point>
    <point p="(r*sin(3*pi/4), -r*cos(3*pi/4)+r)" alignment="ne">
      <m>d=9</m>
    </point>
    <point p="(r*sin(4*pi/4), -r*cos(4*pi/4)+r)" alignment="ne">
      <m>d=12</m>
    </point>
    <point p="(r*sin(5*pi/4), -r*cos(5*pi/4)+r)" alignment="nw">
      <m>d=15</m>
    </point>
    <point p="(r*sin(6*pi/4), -r*cos(6*pi/4)+r)" alignment="nw">
      <m>d=18</m>
    </point>

  </coordinates>

</diagram>

