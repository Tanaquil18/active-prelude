<diagram xmlns="https://prefigure.org" width="250" height="250" margins="5">
  <definition>p=2*pi/8</definition>
  <definition>f(x)=6.5+5.5*cos(p*x)</definition>

  <coordinates bbox="[-1.5,-1.5,14,14]">
    <clip lower-left="(0,0)" dimensions="(20,20)">
      <grid rx="(0,2,14)" ry="(0,2,14)"/>
    </clip>

    <axes id="axes" decorations="no"
	  xlabel="t" ylabel="h"
	  hticks="(0,2,14)" vlabels="(2,2,14)"/>

    <graph function="f" domain="(0,14)"/>

    <label p="(8,f(8))" alignment="ne" offset="(9,9)"
	   clear-background="yes">
      <m>h=g(t)</m>
    </label>

  </coordinates>

</diagram>

