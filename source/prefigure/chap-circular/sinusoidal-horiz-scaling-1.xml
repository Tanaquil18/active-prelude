<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <!-- <definition>f(x)=abs(x-2)-2</definition> -->
  <coordinates bbox="[-8,-8,8,8]">
    <grid-axes xlabel="t" ylabel="y"
	  hticks="(-8,2,8)" vticks="(-8,2,8)"
	  hlabels="(-6,6,6)" vlabels="(-6,6,6)" spacings="((-8,2,8),(-8,2,8))"/>

    <polygon points="((-8,8),(2,-2),(8,4))" stroke="blue" thickness="2"/>
    <graph function="f" stroke="blue"/>

    <point p="(0,0)" />
    <point p="(2,-2)" alignment="se">
      <m>(2,-2)</m>
    </point>
    <point p="(4,0)"/>

    <label p="(6,3)" alignment="nw" clear-background="yes">
      <m>f(t)</m>
    </label>

  </coordinates>


</diagram>

