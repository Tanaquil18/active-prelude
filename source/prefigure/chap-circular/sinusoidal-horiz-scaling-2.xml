<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition>f(x)=-(x+2)^2+2</definition>
  <coordinates bbox="[-8,-8,8,8]">
    <grid-axes xlabel="t" ylabel="y"
	  hticks="(-8,2,8)" vticks="(-8,2,8)"
	  hlabels="(-6,6,6)" vlabels="(-6,6,6)" spacings="((-8,2,8),(-8,2,8))"/>

    <graph function="f"/>

    <point p="(-4,f(-4))"/>
    <point p="(-2,f(-2))" alignment="nw">
      <m>(-2,2)</m>
    </point>
    <point p="(0,f(0))"/>

    <label p="(-6,-4)" alignment="center" clear-background="yes">
      <m>g(t)</m>
    </label>

  </coordinates>


</diagram>

