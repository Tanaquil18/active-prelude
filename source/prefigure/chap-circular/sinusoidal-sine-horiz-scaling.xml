<diagram xmlns="https://prefigure.org" width="450" height="250" margins="5">
  <definition>k=pi/8</definition>
  <definition>f(x)=sin(k*x)</definition>
  <definition>g(x)=f(2*x)</definition>

  <coordinates bbox="[-18,-1.25,18,1.25]">
    <grid rx="(-18,2,18)" ry="(-1.25,0.25,1.25)"/>
    <axes id="axes" decorations="no" xlabel="t"
	  hticks="(-16,4,16)" vticks="(-1,0.5,1)"
	  vlabels="(-1,1,1)"/>

    <label p="(8,0)" alignment="ha" offset="(0,-16)" clear-background="yes">
      <m>\pi</m>
    </label>

    <label p="(-8,0)" alignment="ha" offset="(0,-16)" clear-background="yes">
      <m>-\pi</m>
    </label>

    <label p="(16,0)" alignment="ha" offset="(0,-16)" clear-background="yes">
      <m>2\pi</m>
    </label>

    <label p="(-16,0)" alignment="ha" offset="(0,-16)" clear-background="yes">
      <m>-2\pi</m>
    </label>

    <group outline="tactile">
      <vector v="(-6,0)" tail="(12,-1)" thickness="3"/>
      <vector v="(-2,0)" tail="(4,1)" thickness="3"/>
      <graph function="f" stroke="#aaa" tactile-dash="9 9"/>
      <graph function="g" N="200"/>
    </group>

    <label p="(4,1)" alignment="ne" clear-background="yes" offset="(0,10)">
      <m>f(t)=\sin(t)</m>
    </label>

    <label p="(-10,-1)" alignment="south"
	   clear-background="yes" offset="(0,-10)">
      <m>g(t)=\sin(2t)</m>
    </label>

    <label p="(0,1.25)" alignment="se" tactile-offset="(5,0)">
      <m>y</m>
    </label>

  </coordinates>



</diagram>

