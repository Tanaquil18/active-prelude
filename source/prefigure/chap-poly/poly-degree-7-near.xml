<graphics id="figure" width="250" height="250" margins="5">
  <definition>f(x)=-0.000025*(x+8)*(x+6)*(x-5)*(x**2+1)*(x-7)*(x-9)</definition>

  <coordinates bbox="[-10,-10,10,10]">
    <grid rx="(-10,2,10)" ry="(-10,2,10)"/>
    <axes decorations="no"
	  hticks="(-10,2,10)" vticks="(-10,2,10)"
	  vlabels="(-10,2,10)" hlabels="(-10,2,10)"
	  xlabel="x" ylabel="y"
	  />

    <graph function="f"/>

    <label p="(2,4)" alignment="east" clear-background="yes">
      <m>y=p(x)</m>
    </label>
  </coordinates>

  



</graphics>

