<graphics id="figure" width="250" height="250" margins="5">
  <definition>dx=0.4</definition>
  <definition>f(x)=x^3*(x-1)</definition>

  <coordinates bbox="[-2,-2,3,3]">
    <axes decorations="no"
	  hlabels="(-1,3,2)" vlabels="(-1,3,2)"
	  xlabel="x" ylabel="y"
	  />

    <graph function="f"/>

    <point p="(0,0)"/>
    <point p="(1,0)"/>

    <rectangle lower-left="(-dx,-dx)" dimensions="(2*dx,2*dx)"
	       stroke="#ccc" thickness="2"/>

    <rectangle lower-left="(1-dx,-dx)" dimensions="(2*dx,2*dx)"
	       stroke="#ccc" thickness="2"/>

    <label p="(0.3,-1)" alignment="east" clear-background="yes">
      <m>g(x)=x^3(x-1)</m>
    </label>
  </coordinates>

  



</graphics>

