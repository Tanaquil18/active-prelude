<graphics id="figure" width="250" height="250" margins="5">
  <definition>f(x)=-0.005*(x+3)**3 * (x-1)**2 * (x-4)</definition>

  <coordinates bbox="[-5,-5,5,5]">
    <grid rx="(-5,1,5)" ry="(-5,1,5)"/>
    <axes decorations="no"
	  hticks="(-4,2,4)" vticks="(-4,2,4)"
	  vlabels="(-2,2,2)" hlabels="(-4,4,4)"
	  xlabel="x" ylabel="y"
	  />

    <graph function="f"/>

    <point p="(2,1.25)" alignment="nw" clear-background="yes">
      <m>(2,1.25)</m>
    </point>
    <label p="(-4,4)" alignment="east" clear-background="yes">
      <m>y=g(x)</m>
    </label>
  </coordinates>

  



</graphics>

