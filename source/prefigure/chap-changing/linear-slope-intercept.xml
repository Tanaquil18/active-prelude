<graphics id="figure" width="250" height="250" margins="5">
  <coordinates bbox="[-1,-1,5,5]">
    <group>
      <axes id="axes" xlabel="x" ylabel="y" decorations="no" />
    </group>

    <definition>a=5/3</definition>
    <definition>b=4</definition>
    <definition>f(x)=3-2/3*(x-4/3)</definition>

    <polygon points="((a,f(a)), (a,f(b)), (b,f(b)))"
	     stroke="black" thickness="2"/>
    
    <graph function="f" />

    <point p="(a,f(a))"><m>(x_0,y_0)</m></point>
    <point p="(b,f(b))"><m>(x,y)</m></point>

    <label p="(a,(f(a)+f(b))/2)" alignment="west" offset="(-7,0)"
	   clear-background="yes">
      <m>y-y_0</m>
    </label>
    <label p="((a+b)/2,f(b))" alignment="south" offset="(0,-8)"
	   clear-background="yes">
      <m>x-x_0</m>
    </label>
    <label p="(1,4.0)" alignment="east" 
	   clear-background="yes">
      <m>y=y_0+m(x-x_0)</m>
    </label>

  </coordinates>

</graphics>
