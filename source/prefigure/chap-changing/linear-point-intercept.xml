<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="[12,5,5,5]">
  <coordinates bbox="[-1,-1,5,5]">
    <group>
      <axes id="axes" xlabel="x" ylabel="y" decorations="no" />
    </group>

    <definition>a=0</definition>
    <definition>b=3</definition>
    <definition>f(x)=x/2+1</definition>

    <polygon points="((a,f(a)), (b,f(a)), (b,f(b)))"
	     stroke="black" thickness="2"/>

    <graph function="f" />

    <point p="(a,f(a))" alignment="nw"><m>(0,y_0)</m></point>
    <point p="(b,f(b))" alignment="nw"><m>(x,y)</m></point>

    <label p="(b,(f(a)+f(b))/2)" alignment="east" offset="(7,0)"
	   clear-background="yes">
      <m>y-y_0</m>
    </label>
    <label p="((a+b)/2,f(a))" alignment="south" offset="(0,-8)"
	   clear-background="yes">
      <m>x</m>
    </label>
    <label p="(1,4.0)" alignment="east"
	   clear-background="yes">
      <m>y=y_0+mx</m>
    </label>

  </coordinates>

</diagram>
