<graphics id="figure" width="250" height="250" margins="[5,5,5,5]">
  <coordinates bbox="[-1,-10,6,60]">
    <group>
      <grid />
      <axes id="axes" xlabel="t" ylabel="h" />
    </group>

    <definition>h(t)=-5*t^2+20*t+25</definition>
    <definition>sec(t)=h(2)-5*(t-2)</definition>

    <group outline="tactile">
      <graph function="sec" stroke="red" domain="(0.5,4.5)"
	     tactile-dash="18 9"/>

      <graph function="h" />
    </group>

    <repeat parameter="k=0..4">
      <point p="(k,h(k))"/>
    </repeat>
    
  </coordinates>

</graphics>
