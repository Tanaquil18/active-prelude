<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <coordinates bbox="[-1,-1,6,6]">
    <group>
      <grid id="grid" rx="(-1,1,6)" ry="(-1,1,6)" />
      <axes id="axes" xlabel="t" ylabel="h" decorations="yes"
	    hticks="(1,1,6)" vticks="(1,1,6)"/>
    </group>

    <repeat id="points" parameter="k=0..5">
      <point id="point" p="(k,(12/pi*k)^(1/3))" fill="blue" />
    </repeat>

  </coordinates>

</diagram>

