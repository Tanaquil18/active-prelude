<graphics id="figure" width="250" height="250" margins="5">
  <coordinates bbox="[-20,-10,200,100]">
    <group>
      <grid id="grid" rx="(-20,20,200)" ry="(-10,10,100)"/>
      <axes id="axes" xlabel="N" ylabel="T" decorations="no"
	    hlabels="(40,40,160)" vlabels="(20,20,80)"/>
    </group>

    <definition>f(x)=40+1/4*x</definition>
    <graph function="f" domain="(40,180)"/>
    <point p="(40,50)" />
    <point p="(80,60)" />
    <point p="(120,70)" alignment="se"><m>(120, 70)</m></point>
    <point p="(160,80)" />
    <point p="(180,85)" />

  </coordinates>

</graphics>

