<graphics id="figure" width="250" height="250" margins="5">
  <coordinates bbox="[-4,-4,4,4]">
    <grid />
    <axes id="axes" xlabel="x" ylabel="y"
	  hlabels="(-3,1,3)" vlabels="(-3,1,3)" />

    <polygon points="((-4,4),(-3,1),(2,-1),(4,-5))"
	     cliptobbox="true" thickness="2" stroke="blue"/>
    <polygon points="((-4,-4),(-2,4),(4,1))"
	     cliptobbox="true" thickness="2" stroke="green"
	     tactile-dash="18 18"/>

    <label p="(2.3,-2)" alignment="sw" 
	   clear-background="yes">
      <m>p(x)</m>
    </label>
    <label p="(2.2,2)" alignment="ne" 
	   clear-background="yes">
      <m>q(x)</m>
    </label>

  </coordinates>

</graphics>

