	  cliptobbox="yes" stroke="green" thickness="2"/>
    <point p="(1.5,f(1.5))"><m>(1.5,60)</m></point>
    <point p="(2.5,f(2.5))"><m>(2.5,28)</m></point>

    <label p="(0.3,20)" alignment="east" clear-background="yes"
	   tactile-p="(0.1,10)">
      <m>AV_{[1.5,2.5]}=-32</m>
    </label>


  </coordinates>

</diagram>

