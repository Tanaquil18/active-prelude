<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <coordinates bbox="[-4,-4,4,4]">
    <grid-axes xlabel="x" ylabel="y" />

    <definition>p=3/2</definition>
    <definition>d=4^p/2</definition>
    <definition>f(x)=1+3/2*(x+2)</definition>
    <definition>g(x)=1-(x+2)^p/d</definition>
    <definition>h(x)=-1+(x-2)</definition>
    <definition>f1(x)=f(x)+2</definition>
    <definition>g1(x)=g(x)+2</definition>
    <definition>h1(x)=h(x)+2</definition>
    <definition>f2(x)=f(x+1)</definition>
    <definition>g2(x)=g(x+1)</definition>
    <definition>h2(x)=h(x+1)</definition>
    <definition>f3(x)=f(x+1)+2</definition>
    <definition>g3(x)=g(x+1)+2</definition>
    <definition>h3(x)=h(x+1)+2</definition>

    <group outline="tactile">
      <graph function="f" domain="(-4,-2)" stroke="#999"/>
      <graph function="g" domain="(-2,2)" stroke="#999"/>
      <graph function="h" domain="(2,4)" stroke="#999"/>
    </group>

    <group outline="tactile">
      <graph function="f1" domain="(-4,-2)" stroke="blue"/>
      <graph function="g1" domain="(-2,2)" stroke="blue"/>
      <graph function="h1" domain="(2,4)" stroke="blue"/>
    </group>

    <group outline="tactile">
      <graph function="f2" domain="(-4,-3)" stroke="red"/>
      <graph function="g2" domain="(-3,1)" stroke="red"/>
      <graph function="h2" domain="(1,4)" stroke="red"/>
    </group>

    <group outline="tactile">
      <graph function="f3" domain="(-4,-3)" stroke="orange"/>
      <graph function="g3" domain="(-3,1)" stroke="orange"/>
      <graph function="h3" domain="(1,4)" stroke="orange"/>
    </group>

    <label p="(-3,3)" alignment="nw" clear-background="yes" offset="(7,7)">
      <m>f(x)</m>
    </label>
    <label p="(.7,2.1)" alignment="n" clear-background="yes" offset="(7,7)">
      <m>g(x)</m>
    </label>
    <label p="(-.8,-.2)" alignment="s" clear-background="no">
      <m>h(x)</m>
    </label>
    <label p="(2.8,-0.8)" alignment="ne" clear-background="no">
      <m>r(x)</m>
    </label>
    <point p="(2,-1)" fill="#999"/>
    <point p="(1,-1)"/>
    <point p="(2,1)" fill="blue"/>
    <point p="(1,1)" fill="orange"/>
    <!-- <point p="(1,-1)" alignment="s" clear-background="yes"
	   offset="(2,-7)" tactile-offset="(-60,-15)">
      <m>(1,-1)</m>
    </point> -->


  </coordinates>

</diagram>

