<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <coordinates bbox="[-5,-4,5,4]">

    <grid-axes xlabel="x" ylabel="y"/>

    <definition>f(x)=2+2*(x+2)</definition>
    <definition>g(x)=2</definition>
    <definition>h(x)=2-2*(x-2)</definition>
    <definition>ft(x)=-1/2*f(x-1)+2</definition>
    <definition>gt(x)=-1/2*g(x-1)+2</definition>
    <definition>ht(x)=-1/2*h(x-1)+2</definition>

    <group outline="tactile">
        <graph function="f" domain="(-5,-2)"/>
        <graph function="g" domain="(-2,2)"/>
        <graph function="h" domain="(2,5)"/>
    </group>

    <group outline="tactile">
        <graph function="ft" domain="(-5,-1)" stroke="red"/>
        <graph function="gt" domain="(-1,3)" stroke="red"/>
        <graph function="ht" domain="(3,5)" stroke="red"/>
    </group>

    <point p="(-2,2)" alignment="w" clear-background="yes" offset="(-6,0)" tactile-offset="(-7,15)">
    <m>(-2,2)</m>
    </point>
    <label p="(1.5,2.1)" alignment="n">
    <m>f(x)</m>
    </label>
    <point p="(-1,1)" alignment="s" clear-background="yes" fill="blue" offset="(-2,-2)" tactile-offset="(-7,15)">
    <m>(-1,1)</m>
    </point>
    <label p="(-3,3.5)" alignment="e">
    <m>p(x)</m>
    </label>

  </coordinates>
  
</diagram>