<graphics id="figure" width="250" height="250" margins="5">
  <coordinates bbox="[-4,-4,4,4]">
    <group>
      <grid rx="(-4,1,4)" ry="(-4,1,4)" />
      <axes id="axes" xlabel="x" ylabel="y"
	    hlabels="(-3,1,3)" vlabels="(-3,1,3)"/>
    </group>

    <definition>f1(x)=1+2*(x+4)^2</definition>
    <definition>f2(x)=-x</definition>
    <definition>f3(x)=-4+3*x^2/4</definition>
    <definition>f4(x)=-2.5+3/4*(x-2)</definition>
    <definition>f5(x)=-2.5+sin(pi/(x-1.999999))</definition>

    <definition>a=-2</definition>
    <definition>b=-1</definition>
    <definition>c=3</definition>

    <group outline="tactile">
      <graph function="f1" domain="(-4,-3)" />
      <graph function="f2" domain="(-3,-2)" />
      <graph function="f3" domain="(-2,1)" cliptobbox="no" />
      <graph function="f4" domain="(1,2)" />
      <graph function="f5" domain="(2,4)" N="1050" />
    </group>

    <point p="(a,f2(a))" fill="white"/>
    <point p="(a,f3(a))" fill="blue"/>
    <point p="(b,f3(b))" fill="white"/>
    <point p="(b,1)" fill="blue"/>
    <point p="(c,f5(c))" fill="white"/>

    <label p="(-2.8,3)" alignment="ne" offset="(5,5)" clear-background="yes">
      <m>f(x)</m>
    </label>
      

  </coordinates>

</graphics>

