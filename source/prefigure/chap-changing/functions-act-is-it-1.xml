<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <coordinates bbox="[-5,-5,5,5]">
    <group>
      <grid id="grid" />
      <axes id="axes" decorations="no"
	    hticks="(-5,1,5)" vticks="(-5,1,5)"/>
    </group>

    <label p="(-5,5)" alignment="se" clear-background="yes">
      <m>x^2+y^2=16</m>
    </label>

    <circle center="(0,0)" r="4" stroke="blue" thickness="2"/>
    <point p="(-3,sqrt(7))" alignment="se" clear-background="yes">
      <m>(-3,\sqrt{7})</m>
    </point>
    <point p="(-3,-sqrt(7))" />

  </coordinates>

</diagram>

