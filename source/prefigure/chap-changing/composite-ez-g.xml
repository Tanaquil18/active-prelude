<graphics id="figure" width="250" height="250" margins="5">
  <coordinates bbox="[-2.5,-1.5,2.5,4.5]">
    <group>
      <grid rx="(-2,1,4)" ry="(-2,1,4)" />
      <axes id="axes" xlabel="x" ylabel="y"
	    hlabels="(-2,1,3)" vlabels="(-1,1,3)"/>
    </group>

    <definition>f1(x)=4-x^2</definition>
    <definition>f2(x)=3-x</definition>

    <definition>a=0</definition>
    <definition>b=1</definition>
    <definition>c=2</definition>

    <group outline="tactile">
      <graph function="f1" domain="(-4,1)" />
      <graph function="f2" domain="(1,4)" />
    </group>

    <point p="(a,f1(a))" fill="white"/>
    <point p="(a,1)" fill="blue"/>
    <point p="(b,f1(b))" fill="blue"/>
    <point p="(b,f2(b))" fill="white"/>
    <point p="(c,f2(c))" fill="white"/>

    <label p="(-1.2,3)" alignment="nw" clear-background="yes">
      <m>g(x)</m>
    </label>
      

  </coordinates>

</graphics>

