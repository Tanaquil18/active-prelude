<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="[5,5,5,5]">
  <coordinates bbox="[-3.5,-3.5,3.5,3.5]">
    <group>
      <grid rx="(-3.5,0.5,3.5)" ry="(-3.5,0.5,3.5)" />
      <axes id="axes" hlabels="(-3,1,3)" vlabels="(-3,1,3)" />
    </group>

    <polygon points="((-3,-4),(-1,2),(1,2),(4,-1))" cliptobbox="yes"
	     stroke="green" thickness="2" />
    <polygon points="((-3.5,4),(-1,-1),(1,0),(3,4))" cliptobbox="yes"
	     stroke="blue" thickness="2" tactile-dash="18 18"/>

    <label p="(-2.5,2.5)" alignment="ne" clear-background="yes">
      <m>p(x)</m>
    </label>

    <label p="(-2.3,-3)" alignment="east" clear-background="yes">
      <m>q(x)</m>
    </label>

  </coordinates>

</diagram>
