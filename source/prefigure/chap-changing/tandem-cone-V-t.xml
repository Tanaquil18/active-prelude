<graphics id="figure" width="250" height="250" margins="5">
  <coordinates bbox="[-1,-1,6,6]">
    <group>
      <grid id="grid" rx="(-1,1,6)" ry="(-1,1,6)" />
      <axes id="axes" xlabel="t" ylabel="V" decorations="yes"
	    hticks="(1,1,6)" vticks="(1,1,6)"/>
    </group>

    <repeat id="points" parameter="k=0..5">
      <point id="point" p="(k,0.75*k)" fill="blue" />
    </repeat>
    
  </coordinates>

</graphics>

