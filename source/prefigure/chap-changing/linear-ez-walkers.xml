<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="[12,5,5,5]">
  <coordinates bbox="[-1,-1,11,11]">
    <group>
      <grid />
      <axes id="axes" xlabel="t" ylabel="v"
	    hlabels="(2,2,10)" vlabels="(2,2,10)"/>
    </group>

    <definition>f(t)=4+0.4*t</definition>
    <definition>g(t)=9/10*t</definition>

    <graph function="f" domain="(0,10)"/>
    <graph function="g" stroke="green" domain="(0,10)" tactile-dash="18 18" />

    <label p="(6,5)" alignment="se" clear-background="yes">
      <m>D=g(t)</m>
    </label>
    <label p="(5,6.3)" alignment="nw" clear-background="yes">
      <m>A=f(t)</m>
    </label>

  </coordinates>

</diagram>
