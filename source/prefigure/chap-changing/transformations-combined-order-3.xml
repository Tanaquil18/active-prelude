<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <coordinates bbox="[-4,-4,4,4]">
    <grid-axes xlabel="x" ylabel="y" />

    <definition>p=3/2</definition>
    <definition>d=4^p/2</definition>
    <definition>f(x)=1+3/2*(x+2)</definition>
    <definition>g(x)=1-(x+2)^p/d</definition>
    <definition>h(x)=-1+(x-2)</definition>
    <definition>f1(x)=f(x+1)</definition>
    <definition>g1(x)=g(x+1)</definition>
    <definition>h1(x)=h(x+1)</definition>
    <definition>f2(x)=2*f(x+1)</definition>
    <definition>g2(x)=2*g(x+1)</definition>
    <definition>h2(x)=2*h(x+1)</definition>

    <group outline="tactile">
      <graph function="f1" domain="(-4,-3)" stroke="#999"/>
      <graph function="g1" domain="(-3,1)" stroke="#999"/>
      <graph function="h1" domain="(1,4)" stroke="#999"/>
    </group>

    <group outline="tactile">
      <graph function="f2" domain="(-4,-3)" />
      <graph function="g2" domain="(-3,1)" />
      <graph function="h2" domain="(1,4)" />
    </group>

    <label p="(-3,2)" alignment="ne" clear-background="yes" offset="(7,7)">
      <m>q(x)</m>
    </label>
    <label p="(3.1,0.7)" alignment="ne" clear-background="no">
      <m>s(x)</m>
    </label>
    <point p="(1,-1)" fill="#999"/>
    <point p="(1,-2)" alignment="s" clear-background="yes"
	   offset="(2,-7)" tactile-offset="(-60,-15)">
      <m>(1,-2)</m>
    </point>

  </coordinates>

</diagram>
