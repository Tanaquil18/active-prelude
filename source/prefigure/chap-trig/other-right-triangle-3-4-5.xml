<graphics id="figure" width="250" height="200" margins="5">
  <definition>a=(0,0)</definition>
  <definition>b=(4,0)</definition>
  <definition>c=(4,3)</definition>
  <definition>d=smult(1.5,(0.8,0))</definition>
  <definition>f=smult(1.5,(0.8,0.6))</definition>
  <definition>dx=0.3</definition>

  <coordinates bbox="[-0.5,-0.5,4.5,3.5]">
    <group outline="tactile">
      <polygon points="((4,dx),(4-dx,dx),(4-dx,0))"
	       	   stroke="black" thickness="2" />
      <polygon points="(a,b,c)" stroke="blue" thickness="2" closed="yes"
	       cliptobbox="no"/>
    </group>
    <group outline="tactile">
      <arc points="(b,a,c)" radius="25" pixel-dims="yes"
	   stroke="black" thickness="2" tactile-radius="50"/>
      <polygon points="(a,d,f)" stroke="red" thickness="2" closed="yes"
	       cliptobbox="no" tactile-dash="9 9"/>
    </group>
      
    <point p="a" alignment="sw">
      <m>O</m>
    </point>
    <point p="b" alignment="se">
      <m>Q</m>
    </point>
    <point p="c" alignment="ne">
      <m>P</m>
    </point>

    <label p="midpoint(a,c)" alignment="nw">
      <m>5</m>
    </label>
    <label p="midpoint(b,c)" alignment="east">
      <m>3</m>
    </label>
    <label p="midpoint(a,b)" alignment="south">
      <m>4</m>
    </label>
    <label p="midpoint(a,b)" alignment="south">
      <m>4</m>
    </label>
    <label p="midpoint(a,d)" alignment="south">
      <m>\frac45</m>
    </label>
    <label p="midpoint(f,d)" alignment="east">
      <m>\frac35</m>
    </label>
    <label p="(0.5,0.2)" alignment="east">
      <m>\alpha</m>
    </label>

  </coordinates>

  



</graphics>

