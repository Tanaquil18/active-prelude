<graphics id="figure" width="400" height="400" margins="20">
  <definition>a=pi/4</definition>
  <definition>ep=0.0001</definition>
  <definition>f(x)=sin(a*x)/cos(a*x)</definition>
  <coordinates bbox="[-2,-4,10,4]">

    <grid rx="(-2,1,12)" ry="(-6,1,6)"/>
    <axes decorations="no"
	  hticks="(-2,1,10)" vticks="(-6,1,6)"
	  vlabels="(-2,2,2)"
	  xlabel="t" ylabel="y"/>

    <graph function="f" domain="(-2+ep,2-ep)"/>
    <graph function="f" domain="(2+ep,6-ep)"/>
    <graph function="f" domain="(6+ep,10-ep)"/>

    <repeat parameter="k=0..2">
      <line p1="(2+4*k, 0)" p2="(2+4*k,1)" infinite="yes"
	    stroke="red" thickness="1" tactile-dash="9 9"/>
      <point p="(0+4*k,0)"/>
      <point p="(2/3+4*k,f(2/3))"/>
      <point p="(-2/3+4*k,f(-2/3))"/>
      <point p="(1+4*k,f(1))"/>
      <point p="(4/3+4*k,f(4/3))"/>
      <point p="(-1+4*k,f(-1))"/>
      <point p="(-4/3+4*k,f(-4/3))"/>
    </repeat>

    <label p="(2,3)" alignment="east"
	   clear-background="yes">
      <m>h(t)=\tan(t)</m>
    </label>
    <label p="(2,0)" alignment="ha" offset="(0,-8)">
      <m>\frac{\pi}{2}</m>
    </label>
    <label p="(4,0)" alignment="ha" offset="(0,-16)">
      <m>\pi</m>
    </label>
    <label p="(6,0)" alignment="ha" offset="(0,-8)">
      <m>\frac{3\pi}{2}</m>
    </label>
    <label p="(8,0)" alignment="ha" offset="(0,-16)">
      <m>2\pi</m>
    </label>

  </coordinates>

  



</graphics>

