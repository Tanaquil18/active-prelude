<graphics id="figure" width="500" height="250" margins="5">
  <definition>f(x)=cos(x)</definition>

  <coordinates bbox="[-9*pi/4,-1.2,9*pi/4,1.2]">
    <axes decorations="no" hticks="(-2*pi, pi/4, 2*pi)" vticks="(-1,0.5,1)"
	  vlabels="(-1,1,1)" xlabel="t" ylabel="y"/>
    <graph function="f" dash="4 4" tactile-dash="9 9"/>
    <graph function="f" domain="(0,pi)"/>
    
    <label p="(pi/2,0.5)" alignment="ne">
      <m>y=g(t)</m>
    </label>

    <label p="(-2*pi,0)" alignment="ha" offset="(0,-16)">
      <m>-2\pi</m>
    </label>
    <label p="(-pi,0)" alignment="ha" offset="(0,-16)">
      <m>-\pi</m>
    </label>
    <label p="(pi,0)" alignment="ha" offset="(0,-16)">
      <m>\pi</m>
    </label>
    <label p="(2*pi,0)" alignment="ha" offset="(0,-16)">
      <m>2\pi</m>
    </label>

  </coordinates>

  



</graphics>

