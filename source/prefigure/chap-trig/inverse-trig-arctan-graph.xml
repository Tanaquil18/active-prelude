<graphics id="figure" width="300" height="300" margins="5">
  <definition>ep=0.0001</definition>
  <definition>f(x)=sin(x)/cos(x)</definition>
  <definition>g(x)=x</definition>
  <definition>h(x)=atan(x)</definition>

  <coordinates bbox="[-4,-4,4,4]">
    <axes decorations="yes" hlabels="(3,3,3)"
	  hticks="(-4,1,4)" vticks="(-4,1,4)"
	  vlabels="(-3,3,3)" xlabel="t" ylabel="y"/>

    <graph function="g" stroke="#ccc" />
    <graph function="f" domain="(-pi/2+ep,pi/2-ep)" stroke="green" tactile-dash="9 9"/>
    <graph function="h"/>

    <point p="(2,h(2))"/>
    <point p="(h(2),2)"/>

    <point p="(-2,h(-2))" style="diamond"/>
    <point p="(h(-2),-2)" style="diamond"/>

    <label p="(1,3)" alignment="east" offset="(-20,0)"
	   clear-background="yes">
      <m>y=\tan(t)</m>
    </label>

    <label p="(-1,-0.8)" alignment="nw">
      <m>y=\arctan(t)</m>
    </label>

  </coordinates>

  



</graphics>

