<graphics id="figure" width="250" height="250" margins="5">
  <definition>f(x)=sin(x)</definition>
  <definition>g(x)=x</definition>

  <coordinates bbox="[-3,-3,3,3]">
    <axes decorations="yes" hlabels="(-1,2,3)"
	  vlabels="(-1,2,3)" xlabel="t" ylabel="y"/>

    <graph function="g" stroke="#ccc" />
    <graph function="f" domain="(-pi/2,pi/2)" stroke="green" tactile-dash="9 9"/>
    <parametric-curve x="f" y="g" domain="(-pi/2,pi/2)"/>

    <point p="(-1,-pi/2)" alignment="se"/>
    <point p="(-pi/2,-1)" alignment="nw" offset="(12,8)"
	   tactile-offset="(12,15)">
      <m>y=\sin(t)</m>
    </point>

    <point p="(pi/2,1)" style="diamond" alignment="ne"/>
    <point p="(1,pi/2)" style="diamond" alignment="nw"
	   clear-background="yes">
      <m>y=\arcsin(t)</m>
    </point>

  </coordinates>

  



</graphics>

