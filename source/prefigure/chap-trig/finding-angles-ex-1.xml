<graphics id="figure" width="250" height="100" margins="5">
  <definition>a=(0,0)</definition>
  <definition>b=(23,0)</definition>
  <definition>c=(23,10)</definition>
  <definition>dx=1.5</definition>

  <coordinates bbox="[0,0,25,10]">
    <group outline="tactile">
      <arc points="(b,a,c)" radius="25" pixel-dims="yes"
	   stroke="black" thickness="2" tactile-radius="50"/>
      <polygon points="((23,dx),(23-dx,dx),(23-dx,0))"
	       	   stroke="black" thickness="2" />
      <polygon points="(a,b,c)" stroke="blue" thickness="2" closed="yes"
	       cliptobbox="no"/>
    </group>

    <label p="midpoint(a,c)" alignment="nw">
      <m>3</m>
    </label>
    <label p="midpoint(b,c)" alignment="east">
      <m>1</m>
    </label>
    <label p="(3,0.8)" alignment="east">
      <m>\alpha</m>
    </label>


  </coordinates>

  



</graphics>

