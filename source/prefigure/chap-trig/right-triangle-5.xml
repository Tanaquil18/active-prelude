<graphics id="figure" width="350" height="200" margins="5">
  <definition>p=(0,5)</definition>
  <definition>q=(30,5)</definition>
  <definition>r=(30,20)</definition>
  <coordinates bbox="[0,0,35,20]">

    <group outline="tactile">
      <arc points="(q,p,r)"
	  thickness="2"
	   stroke="black"
	   radius="30" tactile-radius="50"
	   pixel-dims="yes"/>
      <arc points="(p,r,q)"
	  thickness="2"
	   stroke="black"
	   radius="30" tactile-radius="50"
	   pixel-dims="yes"/>
      <polygon points="((30,7),(28,7),(28,5))" stroke="black"
	       thickness="2"/>
      <polygon points="(p,r,q)" cliptobbox="no"
	       closed="yes" stroke="blue" thickness="2"/>
    </group>

    <label p="midpoint(p,r)" alignment="nw" offset="(-8,8)">
      <m>c</m>
    </label>
    <label p="midpoint(p,q)" alignment="south" offset="(0,-8)">
      <m>a</m>
    </label>
    <label p="midpoint(r,q)" alignment="east" offset="(8,0)">
      <m>b</m>
    </label>

    <label p="(5,6)" alignment="east" offset="(0,0)">
      <m>\beta</m>
    </label>
    <label p="(28,16)" alignment="west" offset="(0,0)">
      <m>\alpha</m>
    </label>

    

    

    

    
  </coordinates>

  



</graphics>

