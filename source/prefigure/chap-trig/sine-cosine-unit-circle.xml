<graphics id="figure" width="250" height="250" margins="5">
  <definition>t=0.5</definition>
  <coordinates bbox="[-1.3,-1.3,1.3,1.3]">
    <axes id="axes" decorations="no" />

    <circle center="(0,0)" r="1" />

    <group outline="tactile">
      <line p1="(0,0)" p2="(cos(t), sin(t))" stroke="green"
	    tactile-dash="9 9"/>
      <arc center="(0,0)" range="(0,t*180/pi)" thickness="2"
	   stroke="black"
	   radius="30" tactile-radius="50"
	   pixel-dims="yes"/>
    </group>

    <point p="(1,0)" alignment="sw">
      <m>(1,0)</m>
    </point>
    
    <point p="(cos(t),sin(t))" alignment="nw" clear-background="yes">
      <m>(\cos(t),\sin(t))</m>
    </point>

    <label p="smult(0.5,(cos(t),sin(t)))" alignment="nw">
      <m>1</m>
    </label>

    <label p="smult(0.35,(cos(t/2),sin(t/2)))" alignment="east"
	   offset="(3,3)">
      <m>t</m>
    </label>
	   
    
    

    
  </coordinates>

  



</graphics>

